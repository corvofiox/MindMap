# =============================================================================
# MindMap Backend - Production Environment Configuration
# =============================================================================
# 
# ⚠️  这是生产环境配置模板
# 
# 开发环境请使用 .env.development 文件
# start.js 会自动根据环境选择正确的配置文件
#
# =============================================================================

# Server Configuration
# 生产环境端口（HTTP + WebSocket 融合端口）
PORT=9000
# 开发环境 WebSocket 独立端口（生产环境不使用，WebSocket 共享 PORT）
WS_PORT=9001
NODE_ENV=production

# CORS Configuration
# 生产环境：逗号分隔的允许来源列表，使用 * 允许所有域名
# 示例: ALLOWED_ORIGINS=https://example.com,https://yourdomain.com
ALLOWED_ORIGINS=*

# Database Configuration
# 相对路径基于后端进程 cwd（start.js spawn 时 cwd=backend/），解析为
# <repo>/backend/data/mindmap.db，与 docker-compose 挂载卷对齐。
# ⚠️ 不要写成 backend/data/mindmap.db——那会解析成 backend/backend/data/ 双重嵌套。
DB_FILE=data/mindmap.db

# JWT Configuration
# ⚠️ 必须设置此值！不要使用默认值。
# 在 Docker 环境中会自动生成随机密钥
JWT_SECRET=your-secret-key-change-me-in-production
JWT_EXPIRES_IN=7d

# CSRF Protection Configuration
# ⚠️ 必须设置此值！不要使用默认值。
# 在 Docker 环境中会自动生成随机密钥
CSRF_SECRET=your-csrf-secret-change-me-in-production

# CSRF Cookie Secure 标志
# ⚠️ HTTPS 部署必须显式设置为 true——否则浏览器不会在 HTTPS 下发送
# Secure cookie，登录态与 CSRF 校验会失效；HTTP 环境保持 false/不设置。
# CSRF_COOKIE_SECURE=false

# Reverse Proxy (TRUST_PROXY)
# ⚠️ 默认 false（服务直曝）：直接暴露公网时绝不信任 X-Forwarded-For 头
# （该头完全由客户端控制，无条件信任会让攻击者伪造任意 IP 绕过全局限速）。
# 仅当部署在反向代理（Nginx/Caddy/Traefik 等）之后时，必须显式设置为
# true / 1 / yes（其他任何值一律视为关闭）——否则限速会按反代 IP 聚合，
# 所有用户共享同一限额，容易误触发 429。
# TRUST_PROXY=false

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Logging Configuration
LOG_LEVEL=info
# 相对路径基于后端进程 cwd（同 DB_FILE 语义，解析为 <repo>/backend/data/app.log）
LOG_FILE=data/app.log
