# Server Configuration
# 生产环境端口（HTTP + WebSocket 融合端口）
PORT=9000
# 开发环境 WebSocket 独立端口（生产环境不使用，WebSocket 共享 PORT）
WS_PORT=9001
NODE_ENV=production

# CORS Configuration
# 开发环境：只允许 localhost:5173
# 生产环境：逗号分隔的允许来源列表，使用 * 允许所有域名
# 示例（开发）: ALLOWED_ORIGINS=http://localhost:5173
# 示例（生产）: ALLOWED_ORIGINS=https://example.com,https://yourdomain.com
ALLOWED_ORIGINS=*

# Database Configuration
DB_FILE=data/mindmap.db

# JWT Configuration
# 必须设置此值！不要使用默认值。
# 在 Docker 环境中会自动生成随机密钥
JWT_SECRET=your-secret-key-change-me-in-production
JWT_EXPIRES_IN=7d

# CSRF Protection Configuration
# 必须设置此值！不要使用默认值。
# 在 Docker 环境中会自动生成随机密钥
CSRF_SECRET=your-csrf-secret-change-me-in-production

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=data/app.log
