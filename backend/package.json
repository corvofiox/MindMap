{
  "name": "mindmap-backend",
  "version": "1.0.0",
  "description": "MindMap Backend API Server",
  "private": true,
  "type": "module",
  "author": "corvofiox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/corvofiox/MindMap.git",
    "directory": "backend"
  },
  "keywords": [
    "backend",
    "express",
    "typescript",
    "drizzle-orm",
    "websocket"
  ],
  "scripts": {
    "dev": "tsx watch src",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:init": "tsx src/database/init.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:studio": "npx drizzle-kit studio",
    "db:migrate": "npx drizzle-kit migrate",
    "db:migrate:rollback": "npx drizzle-kit rollback",
    "ws": "node src/websocket/index.js",
    "db:clean": "node -e \"const fs=require('fs'); const base='data/mindmap.db'; ['','-wal','-shm'].forEach(suffix=>{ const p=base+suffix; if(fs.existsSync(p)) fs.rmSync(p); });\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.30.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.98",
    "mindmap-shared": "file:../shared",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.7.0",
    "undici": "^7.29.0",
    "uuid": "^13.0.0",
    "ws": "^8.16.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/ui": "^4.0.17",
    "drizzle-kit": "^0.20.18",
    "eslint": "^8.56.0",
    "node-gyp": "^10.0.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
