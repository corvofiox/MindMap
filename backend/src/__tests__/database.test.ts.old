import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
import Database from 'better-sqlite3';// Using better-sqlite3 for faster tests
import { drizzle } from 'drizzle-orm/better-sqlite3'
import { eq, and, or, like } from 'drizzle-orm'
import {
  users,
  groups,
  projects,
  canvases,
  folders,
  nodeCards,
} from '../database/schema'
import type { NewUser, NewProject, NewCanvas, NewFolder, NewNodeCard } from '../database/schema'

describe('Database Integration Tests', () => {
  let db: Database.Database
  let drizzleInstance: any

  beforeEach(() => {
    // Create in-memory database for each test
    db = new Database(':memory:')
    drizzleInstance = drizzle(db)
  })

  afterEach(() => {
    if (db) {
      db.close()
    }
  })

  describe('Users Table', () => {
    it('should insert and retrieve user', async () => {
      const newUser: NewUser = {
        email: 'test@example.com',
        password: 'hashed_password',
        nickname: 'Test User',
        avatar: 'avatar.jpg',
      }

      const result = await drizzleInstance.insert(users).values(newUser).returning().get()
      expect(result).toBeDefined()
      expect(result.id).toBeGreaterThan(0)
      expect(result.email).toBe('test@example.com')
    })

    it('should enforce unique email constraint', async () => {
      const userData: NewUser = {
        email: 'duplicate@example.com',
        password: 'hash1',
        nickname: 'User1',
      }

      await drizzleInstance.insert(users).values(userData)

      const duplicateUser: NewUser = {
        email: 'duplicate@example.com',
        password: 'hash2',
        nickname: 'User2',
      }

      await expect(async () => {
        await drizzleInstance.insert(users).values(duplicateUser)
      }).rejects.toThrow()
    })

    it('should query user by email', async () => {
      const userData: NewUser = {
        email: 'query@example.com',
        password: 'hash',
        nickname: 'QueryUser',
      }

      await drizzleInstance.insert(users).values(userData)

      const user = await drizzleInstance.select().from(users).where(eq(users.email, 'query@example.com')).get()
      expect(user).toBeDefined()
      expect(user?.email).toBe('query@example.com')
    })

    it('should update user', async () => {
      const userData: NewUser = {
        email: 'update@example.com',
        password: 'hash',
        nickname: 'Original Nick',
      }

      const inserted = await drizzleInstance.insert(users).values(userData).returning().get()

      await drizzleInstance.update(users)
        .set({ nickname: 'Updated Nick' })
        .where(eq(users.id, inserted.id))

      const updated = await drizzleInstance.select().from(users).where(eq(users.id, inserted.id)).get()
      expect(updated?.nickname).toBe('Updated Nick')
    })

    it('should delete user', async () => {
      const userData: NewUser = {
        email: 'delete@example.com',
        password: 'hash',
        nickname: 'DeleteUser',
      }

      const inserted = await drizzleInstance.insert(users).values(userData).returning().get()

      await drizzleInstance.delete(users).where(eq(users.id, inserted.id))

      const deleted = await drizzleInstance.select().from(users).where(eq(users.id, inserted.id)).get()
      expect(deleted).toBeUndefined()
    })
  })

  describe('Groups Table', () => {
    it('should insert group with owner', async () => {
      const user: NewUser = {
        email: 'owner@example.com',
        password: 'hash',
        nickname: 'Owner',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const groupData = {
        name: 'Test Group',
        description: 'Test Description',
        ownerId: insertedUser.id,
        inviteCode: 'INVITE123',
      }

      const group = await drizzleInstance.insert(groups).values(groupData).returning().get()
      expect(group).toBeDefined()
      expect(group.ownerId).toBe(insertedUser.id)
    })

    it('should enforce unique invite code', async () => {
      const user: NewUser = {
        email: 'user@example.com',
        password: 'hash',
        nickname: 'User',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const groupData = {
        name: 'Group1',
        ownerId: insertedUser.id,
        inviteCode: 'SAMECODE',
      }

      await drizzleInstance.insert(groups).values(groupData)

      await expect(async () => {
        await drizzleInstance.insert(groups).values({
          name: 'Group2',
          ownerId: insertedUser.id,
          inviteCode: 'SAMECODE',
        })
      }).rejects.toThrow()
    })
  })

  describe('Projects Table', () => {
    it('should insert project with owner', async () => {
      const user: NewUser = {
        email: 'project@example.com',
        password: 'hash',
        nickname: 'ProjectUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Test Project',
        description: 'Test Description',
        ownerId: insertedUser.id,
        thumbnail: 'thumb.jpg',
        isPublic: false,
      }

      const project = await drizzleInstance.insert(projects).values(projectData).returning().get()
      expect(project).toBeDefined()
      expect(project.ownerId).toBe(insertedUser.id)
      expect(project.isPublic).toBe(0)
    })

    it('should insert project with group', async () => {
      const user: NewUser = {
        email: 'groupuser@example.com',
        password: 'hash',
        nickname: 'GroupUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const groupData = {
        name: 'Test Group',
        ownerId: insertedUser.id,
        inviteCode: 'CODE123',
      }
      const insertedGroup = await drizzleInstance.insert(groups).values(groupData).returning().get()

      const projectData: NewProject = {
        name: 'Group Project',
        ownerId: insertedUser.id,
        groupId: insertedGroup.id,
        isPublic: false,
      }

      const project = await drizzleInstance.insert(projects).values(projectData).returning().get()
      expect(project.groupId).toBe(insertedGroup.id)
    })

    it('should query projects by owner', async () => {
      const user: NewUser = {
        email: 'multi@example.com',
        password: 'hash',
        nickname: 'MultiUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Project 1',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      await drizzleInstance.insert(projects).values(projectData)

      const projectData2: NewProject = {
        name: 'Project 2',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      await drizzleInstance.insert(projects).values(projectData2)

      const userProjects = await drizzleInstance
        .select()
        .from(projects)
        .where(eq(projects.ownerId, insertedUser.id))
        .all()

      expect(userProjects).toHaveLength(2)
    })

    it('should query projects with multiple conditions', async () => {
      const user: NewUser = {
        email: 'search@example.com',
        password: 'hash',
        nickname: 'SearchUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const publicProject: NewProject = {
        name: 'Public Project',
        ownerId: insertedUser.id,
        isPublic: true,
      }
      await drizzleInstance.insert(projects).values(publicProject)

      const privateProject: NewProject = {
        name: 'Private Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      await drizzleInstance.insert(projects).values(privateProject)

      const publicProjects = await drizzleInstance
        .select()
        .from(projects)
        .where(
          and(
            eq(projects.ownerId, insertedUser.id),
            eq(projects.isPublic, 1)
          )
        )
        .all()

      expect(publicProjects).toHaveLength(1)
      expect(publicProjects[0].name).toBe('Public Project')
    })
  })

  describe('Canvases Table', () => {
    it('should insert canvas with project', async () => {
      const user: NewUser = {
        email: 'canvas@example.com',
        password: 'hash',
        nickname: 'CanvasUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Canvas Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const canvasData: NewCanvas = {
        name: 'Test Canvas',
        projectId: insertedProject.id,
        yjsData: 'base64data',
      }

      const canvas = await drizzleInstance.insert(canvases).values(canvasData).returning().get()
      expect(canvas).toBeDefined()
      expect(canvas.projectId).toBe(insertedProject.id)
    })

    it('should query canvases with like filter', async () => {
      const user: NewUser = {
        email: 'like@example.com',
        password: 'hash',
        nickname: 'LikeUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const canvas1: NewCanvas = {
        name: 'Meeting Notes',
        projectId: insertedProject.id,
        yjsData: 'data1',
      }
      await drizzleInstance.insert(canvases).values(canvas1)

      const canvas2: NewCanvas = {
        name: 'Project Plan',
        projectId: insertedProject.id,
        yjsData: 'data2',
      }
      await drizzleInstance.insert(canvases).values(canvas2)

      const searchResults = await drizzleInstance
        .select()
        .from(canvases)
        .where(
          and(
            eq(canvases.projectId, insertedProject.id),
            like(canvases.name, '%Notes%')
          )
        )
        .all()

      expect(searchResults).toHaveLength(1)
      expect(searchResults[0].name).toBe('Meeting Notes')
    })
  })

  describe('Folders Table', () => {
    it('should insert folder with project', async () => {
      const user: NewUser = {
        email: 'folder@example.com',
        password: 'hash',
        nickname: 'FolderUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Folder Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const folderData: NewFolder = {
        name: 'Test Folder',
        projectId: insertedProject.id,
        parentId: null,
        order: 1,
      }

      const folder = await drizzleInstance.insert(folders).values(folderData).returning().get()
      expect(folder).toBeDefined()
      expect(folder.projectId).toBe(insertedProject.id)
    })

    it('should support hierarchical folders', async () => {
      const user: NewUser = {
        email: 'hierarchy@example.com',
        password: 'hash',
        nickname: 'HierarchyUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Hierarchy Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const parentFolder: NewFolder = {
        name: 'Parent',
        projectId: insertedProject.id,
        parentId: null,
        order: 1,
      }
      const insertedParent = await drizzleInstance.insert(folders).values(parentFolder).returning().get()

      const childFolder: NewFolder = {
        name: 'Child',
        projectId: insertedProject.id,
        parentId: insertedParent.id,
        order: 2,
      }
      const insertedChild = await drizzleInstance.insert(folders).values(childFolder).returning().get()

      expect(insertedChild.parentId).toBe(insertedParent.id)
    })
  })

  describe('NodeCards Table', () => {
    it('should insert node card with canvas', async () => {
      const user: NewUser = {
        email: 'node@example.com',
        password: 'hash',
        nickname: 'NodeUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Node Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const canvasData: NewCanvas = {
        name: 'Node Canvas',
        projectId: insertedProject.id,
        yjsData: 'data',
      }
      const insertedCanvas = await drizzleInstance.insert(canvases).values(canvasData).returning().get()

       const nodeData: NewNodeCard = {
        name: 'Test Node',
        content: 'Test Content',
        projectId: insertedCanvas.id,
        color: '#ffffff',
      }

      const node = await drizzleInstance.insert(nodeCards).values(nodeData).returning().get()
      expect(node).toBeDefined()
      expect(node.canvasId).toBe(insertedCanvas.id)
    })

    it('should store JSON style data', async () => {
      const user: NewUser = {
        email: 'style@example.com',
        password: 'hash',
        nickname: 'StyleUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Style Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      const canvasData: NewCanvas = {
        name: 'Style Canvas',
        projectId: insertedProject.id,
        yjsData: 'data',
      }
      const insertedCanvas = await drizzleInstance.insert(canvases).values(canvasData).returning().get()

      const styleData = { color: '#ff0000', fontSize: 16 }
      const nodeData: NewNodeCard = {
        name: 'Styled Node',
        content: 'Content',
        canvasId: insertedCanvas.id,
        style: JSON.stringify(styleData),
      }

      const node = await drizzleInstance.insert(nodeCards).values(nodeData).returning().get()

      expect(node.style).toBe(JSON.stringify(styleData))
    })
  })

  describe('Transactions', () => {
    it('should rollback on error', async () => {
      const user: NewUser = {
        email: 'transaction@example.com',
        password: 'hash',
        nickname: 'TransactionUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      try {
        // This should fail due to duplicate email
        await db.exec('BEGIN TRANSACTION')

        await drizzleInstance.insert(users).values({
          email: 'transaction@example.com',
          password: 'hash2',
          nickname: 'Transaction2',
        })

        await db.exec('COMMIT')
      } catch (error) {
        await db.exec('ROLLBACK')
        expect(error).toBeDefined()
      }

      // User should still exist
      const existingUser = await drizzleInstance.select().from(users).where(eq(users.email, 'transaction@example.com')).get()
      expect(existingUser).toBeDefined()
      expect(existingUser?.nickname).toBe('TransactionUser')
    })

    it('should commit multiple operations', async () => {
      const user: NewUser = {
        email: 'commit@example.com',
        password: 'hash',
        nickname: 'CommitUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'Commit Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }

      await db.exec('BEGIN TRANSACTION')
      await drizzleInstance.insert(projects).values(projectData)

      const canvasData: NewCanvas = {
        name: 'Commit Canvas',
        projectId: (await drizzleInstance.select().from(projects).where(eq(projects.name, 'Commit Project')).get())!.id,
        yjsData: 'data',
      }
      await drizzleInstance.insert(canvases).values(canvasData)
      await db.exec('COMMIT')

      const canvas = await drizzleInstance.select().from(canvases).where(eq(canvases.name, 'Commit Canvas')).get()
      expect(canvas).toBeDefined()
    })
  })

  describe('Foreign Key Constraints', () => {
    it('should enforce user->projects relationship', async () => {
      // Try to create project with non-existent user
      const invalidProject: NewProject = {
        name: 'Invalid Project',
        ownerId: 99999, // Non-existent user
        isPublic: false,
      }

      await expect(async () => {
        await drizzleInstance.insert(projects).values(invalidProject)
      }).rejects.toThrow()
    })

    it('should enforce project->canvas relationship', async () => {
      // Try to create canvas with non-existent project
      const invalidCanvas: NewCanvas = {
        name: 'Invalid Canvas',
        projectId: 99999, // Non-existent project
        yjsData: 'data',
      }

      await expect(async () => {
        await drizzleInstance.insert(canvases).values(invalidCanvas)
      }).rejects.toThrow()
    })

    it('should enforce project->folder relationship', async () => {
      const user: NewUser = {
        email: 'fk@example.com',
        password: 'hash',
        nickname: 'FKUser',
      }
      const insertedUser = await drizzleInstance.insert(users).values(user).returning().get()

      const projectData: NewProject = {
        name: 'FK Project',
        ownerId: insertedUser.id,
        isPublic: false,
      }
      const insertedProject = await drizzleInstance.insert(projects).values(projectData).returning().get()

      // Try to create folder with non-existent parent
      const invalidFolder: NewFolder = {
        name: 'Invalid Folder',
        projectId: insertedProject.id,
        parentId: 99999, // Non-existent folder
        order: 1,
      }

      await expect(async () => {
        await drizzleInstance.insert(folders).values(invalidFolder)
      }).rejects.toThrow()
    })
  })
})
