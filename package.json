{
  "name": "mindmap",
  "version": "1.0.0",
  "description": "MindMap - Personal Mind Organization Tool",
  "private": true,
  "type": "module",
  "author": "corvofiox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/corvofiox/MindMap.git"
  },
  "keywords": [
    "mindmap",
    "react",
    "express",
    "typescript",
    "collaboration"
  ],
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "init:env": "node start.js --generate-env-only",
    "start": "node start.js",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend && npm run dev",
    "install:all": "node start.js --install-only",
    "db:init": "cd backend && npm run db:init",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "dev": "node start.js",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:run": "npm run test:frontend:run && npm run test:backend:run",
    "test:frontend:run": "cd frontend && npm run test:run",
    "test:backend:run": "cd backend && npm run test:run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.8",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  }
}
