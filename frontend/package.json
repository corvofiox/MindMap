{
  "name": "mindmap-frontend",
  "version": "1.0.0",
  "description": "MindMap Frontend Application",
  "private": true,
  "type": "module",
  "author": "corvofiox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/corvofiox/MindMap.git",
