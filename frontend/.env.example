# API Configuration
# 开发环境：使用具体的 URL
# 生产环境：使用相对路径（空字符串），API 请求会自动发送到当前域名
VITE_API_URL=
VITE_WS_URL=

# Application Configuration
VITE_APP_NAME=MindMap
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG_LOGGER=false
VITE_ENABLE_ANALYTICS=false

# Development Configuration
VITE_DEV_MODE=false
VITE_HOT_MODULE_REPLACEMENT=false
